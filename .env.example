# ============================================================
# CẤU HÌNH AI LECTURE VIDEO AGENT
# ============================================================

# 1. LLM API Key (Chọn gemini hoặc openai)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# 2. Edge-TTS Giọng đọc tiếng Việt (vi-VN-HoaiMyNeural: Nữ / vi-VN-NamMinhNeural: Nam)
TTS_VOICE=vi-VN-HoaiMyNeural
TTS_RATE=+0%
TTS_VOLUME=+0%

# 3. Voice Cloning (RVC)
RVC_MODEL_PATH=models/my_voice.pth
RVC_INDEX_PATH=models/my_voice.index
RVC_PITCH=0
RVC_DEVICE=cuda:0

# 4. Thông số Video
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=24
SLIDE_PAUSE_DURATION=0.6
